
#include <Adafruit_GFX.h>
#include <Adafruit_ST7789.h>
#include <SPI.h>

#include "plant_frames.h"
#include "lovely.h"

// LCD pin connections
#define TFT_CS   5
#define TFT_DC   16
#define TFT_RST  17
#define TFT_SCLK 18
#define TFT_MOSI 23

// Soil moisture sensor
#define SOIL_PIN 32

Adafruit_ST7789 tft(TFT_CS, TFT_DC, TFT_RST);

// Adjust this after checking your sensor readings
const int DRY_THRESHOLD = 2500;

// Animation settings
const int SCALE = 2;
const int DISPLAY_W = 240;
const int DISPLAY_H = 280;
const int FRAME_DELAY_MS = 200;

// This buffer supports 120-pixel-wide source frames at 2x scale
uint16_t scaledLine[240];

bool previousDryState = false;
bool firstRun = true;

// Read the soil sensor
bool isSoilDry() {
  int reading = analogRead(SOIL_PIN);

  Serial.print("Soil moisture reading: ");
  Serial.println(reading);

  // This assumes a higher reading means drier soil.
  return reading > DRY_THRESHOLD;
}

// Draw one animation frame using a line buffer to save ESP32 RAM
void drawFrame(const uint16_t* frame, int width, int height) {
  int drawWidth = width * SCALE;
  int drawHeight = height * SCALE;

  int startX = (DISPLAY_W - drawWidth) / 2;
  int startY = (DISPLAY_H - drawHeight) / 2;

  for (int y = 0; y < height; y++) {
    int out = 0;

    // Enlarge each pixel horizontally
    for (int x = 0; x < width; x++) {
      uint16_t color = pgm_read_word(&frame[y * width + x]);

      for (int k = 0; k < SCALE; k++) {
        scaledLine[out++] = color;
      }
    }

    // Draw each enlarged row twice
    tft.startWrite();

    for (int k = 0; k < SCALE; k++) {
      tft.setAddrWindow(
        startX,
        startY + y * SCALE + k,
        drawWidth,
        1
      );

      for (int x = 0; x < drawWidth; x++) {
        tft.writeColor(scaledLine[x], 1);
      }
    }

    tft.endWrite();
  }
}

// Play an animation until the soil changes state
template <size_t FRAME_COUNT, size_t FRAME_PIXELS>
void playAnimation(
  const uint16_t (&frames)[FRAME_COUNT][FRAME_PIXELS],
  int width,
  int height,
  bool animationIsForDrySoil
) {
  for (size_t frame = 0; frame < FRAME_COUNT; frame++) {
    bool currentlyDry = isSoilDry();

    if (currentlyDry != animationIsForDrySoil) {
      return;
    }

    drawFrame(&frames[frame][0], width, height);
    delay(FRAME_DELAY_MS);
  }
}

void setup() {
  Serial.begin(115200);

  analogReadResolution(12);

  // Initialize LCD SPI
  SPI.begin(TFT_SCLK, -1, TFT_MOSI, TFT_CS);

  tft.init(240, 280);
  tft.setRotation(0);
  tft.fillScreen(ST77XX_BLACK);

  Serial.println("Plant Buddy started!");
  Serial.println("Checking soil moisture...");
}

void loop() {
  bool dry = isSoilDry();

  // Clear the screen when switching animations
  if (firstRun || dry != previousDryState) {
    tft.fillScreen(ST77XX_BLACK);

    previousDryState = dry;
    firstRun = false;
  }

  if (dry) {
    // Dry soil: play the plant needing water
    playAnimation(
      plantFrames,
      PLANT_FRAME_W,
      PLANT_FRAME_H,
      true
    );
  } else {
    // Moist soil: play the lovely happy animation
    playAnimation(
      lovelyFrames,
      LOVELY_FRAME_W,
      LOVELY_FRAME_H,
      false
    );
  }
}
